{
    "name": "microbit-rc",
    "version": "2.0.3",
    "description": "Customizable Bluetooth gamepad for micro:bit: buttons, joysticks, toggles, sliders and displays from the RC Pad web app",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*"
    },
    "files": [
        "README.md",
        "gamepad.ts",
        "docs/is-on.md",
        "docs/joystick.md",
        "docs/on-button.md",
        "docs/on-change.md",
        "docs/show-text.md",
        "docs/show.md",
        "docs/value.md",
        "_locales/el/microbit-rc-jsdoc-strings.json",
        "_locales/el/microbit-rc-strings.json"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "blocksprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}